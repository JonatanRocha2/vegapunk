{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "ignoreScripts": true,
  "osvVulnerabilityAlerts": true,
  "schedule": ["at any time"],
  "semanticCommits": "enabled",
  "labels": ["dependencies", "security-review-required"],
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned npm CLIs in both installers",
      "managerFilePatterns": ["/^install\\.(?:ps1|sh)$/", "/^\\.github/workflows/validate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=npm depName=(?<depName>\\S+)\\s+\\$[A-Za-z]+ = \"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=npm depName=(?<depName>\\S+)\\s+[a-z_]+=(?<currentValue>\\S+)",
        "# renovate: datasource=npm depName=(?<depName>\\S+)\\s+SKILLS_CLI_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update the Caveman skill release and immutable commit together",
      "managerFilePatterns": ["/^install\\.(?:ps1|sh)$/", "/^\\.github/workflows/validate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=JuliusBrussee/caveman\\s+\\$CavemanVersion = \"(?<currentValue>[^\"]+)\"\\s+\\$CavemanCommit = \"(?<currentDigest>[a-f0-9]{40})\"",
        "# renovate: datasource=github-releases depName=JuliusBrussee/caveman\\s+caveman_version=(?<currentValue>\\S+)\\s+caveman_commit=(?<currentDigest>[a-f0-9]{40})",
        "# renovate: datasource=github-releases depName=JuliusBrussee/caveman\\s+CAVEMAN_VERSION: \"(?<currentValue>[^\"]+)\"\\s+CAVEMAN_COMMIT: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "JuliusBrussee/caveman",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the official AWS skill bundle commit",
      "managerFilePatterns": ["/^install\\.(?:ps1|sh)$/", "/^\\.github/workflows/validate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-digest depName=aws/agent-toolkit-for-aws\\s+\\$AwsToolkitRef = \"(?<currentValue>[^\"]+)\"\\s+\\$AwsToolkitCommit = \"(?<currentDigest>[a-f0-9]{40})\"",
        "# renovate: datasource=github-digest depName=aws/agent-toolkit-for-aws\\s+aws_toolkit_ref=(?<currentValue>\\S+)\\s+aws_toolkit_commit=(?<currentDigest>[a-f0-9]{40})",
        "# renovate: datasource=github-digest depName=aws/agent-toolkit-for-aws\\s+AWS_TOOLKIT_REF: \"(?<currentValue>[^\"]+)\"\\s+AWS_TOOLKIT_COMMIT: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-digest",
      "depNameTemplate": "aws/agent-toolkit-for-aws"
    },
    {
      "customType": "regex",
      "description": "Update recommended skill commits",
      "managerFilePatterns": ["/^install\\.(?:ps1|sh)$/", "/^\\.github/workflows/validate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-digest depName=(?<depName>mattpocock/skills|anthropics/skills)\\s+\\$[A-Za-z]+Ref = \"(?<currentValue>[^\"]+)\"\\s+\\$[A-Za-z]+Commit = \"(?<currentDigest>[a-f0-9]{40})\"",
        "# renovate: datasource=github-digest depName=(?<depName>mattpocock/skills|anthropics/skills)\\s+[a-z_]+_ref=(?<currentValue>\\S+)\\s+[a-z_]+_commit=(?<currentDigest>[a-f0-9]{40})",
        "# renovate: datasource=github-digest depName=(?<depName>mattpocock/skills|anthropics/skills)\\s+[A-Z_]+_REF: \"(?<currentValue>[^\"]+)\"\\s+[A-Z_]+_COMMIT: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-digest"
    }
  ],
  "packageRules": [
    {
      "description": "Allow time for newly published external artifacts to be reviewed or withdrawn",
      "matchDatasources": ["npm", "github-releases", "github-tags", "github-digest"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep all Caveman release pins synchronized in one review",
      "matchPackageNames": ["JuliusBrussee/caveman", "@caveman-ai/cli"],
      "groupName": "Caveman external dependencies"
    },
    {
      "description": "Keep the skills CLI synchronized across installers and validation",
      "matchPackageNames": ["skills"],
      "groupName": "Agent Skills CLI"
    },
    {
      "description": "Review the official AWS skill bundle as one external dependency",
      "matchPackageNames": ["aws/agent-toolkit-for-aws"],
      "groupName": "Official AWS skill bundle"
    },
    {
      "description": "Review recommended skills as one external bundle",
      "matchPackageNames": ["mattpocock/skills", "anthropics/skills"],
      "groupName": "Recommended Agent Skills"
    }
  ]
}
